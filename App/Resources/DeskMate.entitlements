<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app stays sandboxed. Foundation Models needs no entitlement.
	     My files reads only what the person picks in the open panel, and keeps access across launches
	     with app-scoped security bookmarks. DeskMate never writes to a file the person picked for reading:
	     read-write exists only so "Save as Markdown" can write the one file the person names in the save panel.
	     Saved conversations live in DeskMate's own Application Support folder, which needs no entitlement.
	     Connections makes outgoing requests only to the addresses the person adds (https, or http to
	     this Mac for development), so it needs network.client. There is no server entitlement.
	     The App Group that shares the generic widget snapshot is added by scripts/build-app.sh when
	     a Team ID is given; without one it is left out, because an App Group needs a signing identity with a Team ID. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
