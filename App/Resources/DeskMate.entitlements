<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app stays sandboxed. Foundation Models needs no entitlement.
	     Later packages add, and only when their feature lands:
	     files.user-selected.read-only (selected library folders and files),
	     network.client (approved MCP endpoints), and the App Group for the widget. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
